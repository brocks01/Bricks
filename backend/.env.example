# Copy to .env (never committed). These are SERVER secrets: never put them in the app.

# Project Settings -> Data API -> Project URL (same as the app's EXPO_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# Project Settings -> API Keys -> Secret keys -> sb_secret_... (or legacy "service_role")
# Full database access. Backend only.
SUPABASE_SECRET_KEY=sb_secret_...

# "Connect" button (top of dashboard) -> Connection string -> Session pooler -> URI.
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Only if Project Settings -> JWT Keys shows the legacy HS256 secret in use.
# With the newer signing keys, leave empty: the backend checks tokens with Supabase's public keys.
SUPABASE_JWT_SECRET=

# Demo mode: requests without a sign-in act as the sample member (Raj), SOS helpers
# "set off" by themselves, and the app's "they said yes" family control works.
# true for local dev and the stage demo; false for anything real people use.
DEMO_MODE=true

# Browser origins allowed to call the API (only needed for the Expo web build), JSON list.
# CORS_ORIGINS=["http://localhost:8081"]

# ---- Voice agent (Buddy), phone calls and WhatsApp ----

# Buddy's brain: https://aistudio.google.com/apikey -> Create API key (free tier is enough).
# Use a project WITHOUT billing: a billed project with no prepay credit answers 402.
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash; gemini-3.1-flash-lite is the fallback when it's busy.
# GEMINI_MODEL=gemini-3.5-flash

# The public https address of this API, e.g. your ngrok URL (Twilio and Meta call back to it).
# Claim a free static ngrok domain so it doesn't change on every restart.
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Twilio console -> Account info (Account SID, Auth token).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Bricks phone number, E.164 (e.g. +16505551234). Phone Numbers -> Buy a number (Voice).
TWILIO_NUMBER=
# Reject webhook calls not signed by Twilio. Keep true; false only for local curl tests.
TWILIO_VALIDATE_SIGNATURE=true
# Speech recognition language on calls: en-IN (default), or en-GB / en-US if it hears badly
CALL_SPEECH_LANGUAGE=en-IN

# Optional: path to a Google Cloud service-account JSON (Speech / Text-to-Speech) for nicer
# call voices. Keep the file OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# WhatsApp (later): Meta for Developers -> your app -> WhatsApp -> API Setup.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Any random string you make up; enter the same one when you set the webhook.
META_WA_VERIFY_TOKEN=
# App settings -> Basic -> App secret.
META_APP_SECRET=
