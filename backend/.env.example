# Copy to .env and fill in yourself. The real .env is never committed or shared. Names only here.
DATABASE_URL=postgresql://bricks_app:PASSWORD@localhost:5432/bricks
JWT_SECRET=change-me
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Phone voice agent (Twilio + Gemini Live). Same names as the Jambagrad voice module.
VOICE_PROVIDER=twilio
VOICE_PUBLIC_URL=
VOICE_ALLOWED_NUMBERS=
VOICE_ADMIN_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GEMINI_API_KEY=
PARALLEL_API_KEY=
# Sign-in providers: GOOGLE_CLIENT_ID (public id). SINGPASS_CLIENT_ID and DIGILOCKER_CLIENT_ID stay empty until registered.
GOOGLE_CLIENT_ID=
# Demo deployments only: show the sign-in code on the screen (the real email is still sent; limits unchanged). Empty = off.
DEMO_SIGNIN_OTP=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Translation of member-written content. Tries the providers in this order and stops at the first that works.
TRANSLATE_PROVIDERS=gemini,google,local
TRANSLATE_DAILY_CHARS_PER_USER=20000
TRANSLATE_DAILY_CHARS_TOTAL=500000
TRANSLATE_TIMEOUT_SECONDS=15
# Optional: pin a Gemini text model. Empty = pick a Flash model from the account's own model list.
TRANSLATE_MODEL=
# Optional: Google Cloud Translation v2 key. Empty = that provider is skipped.
GOOGLE_TRANSLATE_API_KEY=
# Optional: the owner's self-hosted engine (SHRAVANA) POST endpoint. Empty = that provider is skipped.
LOCAL_TRANSLATE_URL=
