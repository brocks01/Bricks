# Copy to .env (never committed). These are SERVER secrets: never put them in the app.

# Project Settings -> Data API -> Project URL (same as the app's EXPO_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# Project Settings -> API Keys -> Secret keys -> sb_secret_... (or legacy "service_role")
# Full database access. Backend only.
SUPABASE_SECRET_KEY=sb_secret_...

# "Connect" button (top of dashboard) -> Connection string -> Session pooler -> URI.
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Only if Project Settings -> JWT Keys shows the legacy HS256 secret in use.
# With the newer signing keys, leave empty: the backend checks tokens with Supabase's public keys.
SUPABASE_JWT_SECRET=

# Demo mode: requests without a sign-in act as the sample member (Raj), SOS helpers
# "set off" by themselves, and the app's "they said yes" family control works.
# true for local dev and the stage demo; false for anything real people use.
DEMO_MODE=true

# Browser origins allowed to call the API (only needed for the Expo web build), JSON list.
# CORS_ORIGINS=["http://localhost:8081"]

# ---- WhatsApp (docs/06, backend/README.md "WhatsApp") ----
# The https address Meta and Twilio call (your ngrok URL in development).
PUBLIC_BASE_URL=https://your-name.ngrok-free.app

# Meta Cloud API: developers.facebook.com -> your app -> WhatsApp -> API Setup.
# A permanent system-user token (Business Settings -> System users), not the 24 h one.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
# App settings -> Basic -> App secret (checks the webhook signature).
META_APP_SECRET=
# Any random string; paste the same one into Meta's webhook settings.
META_WA_VERIFY_TOKEN=

# Twilio WhatsApp sandbox (backup route, walk-up judges). Console -> Messaging ->
# Try it out -> Send a WhatsApp message. Set "When a message comes in" to
# $PUBLIC_BASE_URL/wa/twilio (POST).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_SANDBOX_NUMBER=+14155238886
TWILIO_WA_JOIN_CODE=
TWILIO_VALIDATE_SIGNATURE=true

# Sends the 8 am check-in, reminders and the missed check-in ladder. One server only.
WA_SCHEDULER=false
# Stage demo: the ladder steps are 1 / 2 / 3 minutes instead of 2 / 3 / 4 hours.
DEMO_FAST_ESCALATION=false

# Voice notes: speech to text (Google AI Studio -> API key).
GEMINI_API_KEY=
