# Copy to .env and fill in yourself. The real .env is never committed or shared. Names only here.
DATABASE_URL=postgresql://bricks_app:PASSWORD@localhost:5432/bricks
JWT_SECRET=change-me
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Phone voice agent (Twilio + Gemini Live). Same names as the Jambagrad voice module.
VOICE_PROVIDER=twilio
VOICE_PUBLIC_URL=
VOICE_ALLOWED_NUMBERS=
VOICE_ADMIN_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GEMINI_API_KEY=
PARALLEL_API_KEY=
# Sign-in providers: GOOGLE_CLIENT_ID (public id). SINGPASS_CLIENT_ID and DIGILOCKER_CLIENT_ID stay empty until registered.
GOOGLE_CLIENT_ID=
