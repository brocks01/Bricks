# Copy to .env.local (never committed). Only EXPO_PUBLIC_* values reach the app bundle,
# so never put secrets here.

# Backend base URL: local ngrok tunnel or the hosted `demo` environment (iteration 2.1+).
EXPO_PUBLIC_API_URL=https://demo.example.com

# true = read from src/mocks (Phase 1). Switches to false in iteration 2.1.
EXPO_PUBLIC_USE_MOCKS=true

# Shows the hidden dev screens (component gallery). Never true in preview/production builds.
EXPO_PUBLIC_DEV_TOOLS=true
