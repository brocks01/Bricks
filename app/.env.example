# Copy to .env.local (never committed). Only EXPO_PUBLIC_* values reach the app bundle,
# and anyone can read them from the app, so never put secrets here.

# Backend base URL: local ngrok tunnel or the hosted `demo` environment.
# Leave it out to run on mock data (src/mocks).
# EXPO_PUBLIC_API_URL=https://demo.example.com

# true = mock data even when an API URL is set (offline demos). Default false.
EXPO_PUBLIC_USE_MOCKS=false

# Supabase Auth (Google sign-in). Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_…, or the legacy "anon" key). Never the secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Shows "Use my phone number" on Sign in. Needs an SMS provider in Supabase first.
EXPO_PUBLIC_PHONE_SIGN_IN=false

# Shows the hidden dev screens (component gallery). Never true in preview/production builds.
EXPO_PUBLIC_DEV_TOOLS=true

# Build-time only (not EXPO_PUBLIC): Google Maps key for our Android builds.
# Store it as an EAS secret: eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --visibility secret
GOOGLE_MAPS_ANDROID_API_KEY=
